# Project PDFs (paper copy, course proposal) — keep local, don't commit.
# The markdown docs in docs/ are tracked.
docs/*.pdf

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Local data / datasets
data/

# Scratch output of the training scripts (run from inside MELD/ or IEMOCAP/).
# Curated copies of the results live in the tracked top-level results/ folder.
/MELD/results/
/IEMOCAP/results/

# Per-run model weights (~23 MB each); never committed
**/best_model.pkl

# Local staging folder for artifacts downloaded from Google Drive
/drive_export/

# Locally downloaded/generated model checkpoints
models/

# OS / editor files
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local assistant notes
CLAUDE.md
.claude/
