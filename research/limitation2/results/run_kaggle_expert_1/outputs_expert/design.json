{
  "expert_model": "FacebookAI/roberta-large",
  "expert_seeds": [
    1,
    2,
    3
  ],
  "expert_epochs": 6,
  "expert_lr": 1e-05,
  "expert_batch": 16,
  "expert_max_len": 256,
  "expert_retry_rule": "one retry (seed + 1000) if best dev macro-F1 < 35.0",
  "fusion": "score = (1 - w) log p_ECERC + w log p_expert",
  "w_grid": [
    0.0,
    0.05,
    0.1,
    0.15,
    0.2,
    0.25,
    0.3,
    0.35,
    0.4,
    0.45,
    0.5,
    0.55,
    0.6,
    0.65,
    0.7,
    0.75,
    0.8,
    0.85,
    0.9,
    0.95,
    1.0
  ],
  "selection": "highest mean dev macro-F1 over pairs; ties to the smaller w",
  "gate": "cross-fitted dev gain >= 0.5",
  "criteria": {
    "primary": "mean over (ECERC checkpoint x expert seed) pairs of test macro-F1(fused) - macro-F1(ECERC alone)",
    "success": [
      "delta >= +1.0",
      "procedure-level 95% CI lower bound > 0",
      "mean F1 change > 0 for Fear and for Disgust",
      "delta > 0 in at least 70% of pairs",
      "accuracy change >= -1.0",
      "weighted-F1 change >= -0.5",
      "every class: mean F1 change >= -2.0"
    ],
    "verdict_order": [
      "SUCCESS",
      "TRADE-OFF (efficacy met, a guardrail fails)",
      "PARTIAL (macro-F1 target met, Fear/Disgust/consistency not)",
      "FAILURE (CI upper bound < +1.0)",
      "INCONCLUSIVE"
    ],
    "guardrails_judged_on": "point estimates; 95% CIs reported"
  }
}